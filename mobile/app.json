{
  "expo": {
    "name": "BLE Jarvis",
    "slug": "ble-jarvis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.msoft.blejarvis.mobile",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "BLE Jarvis advertises a Bluetooth signal so your Mac knows when you're at your desk.",
        "NSLocalNetworkUsageDescription": "BLE Jarvis syncs your activity feed and settings with the Jarvis app on your Mac over your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": [
          "bluetooth-peripheral"
        ]
      },
      "appleTeamId": "359R7KZAFR"
    },
    "android": {
      "package": "com.msoft.blejarvis.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
